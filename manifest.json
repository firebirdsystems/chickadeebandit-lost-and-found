{
  "id": "lost-and-found",
  "name": "Lost & Found",
  "version": "1.0.0",
  "description": "Post lost or found items — pets, keys, packages, bikes — with a photo and last-known location. Surfaces likely matches between open lost and found posts and closes both out once an item is claimed.",
  "entrypoint": "index.html",
  "runtime": "static",
  "icon": "🔎",
  "category": "community",
  "tags": ["lost", "found", "hoa", "neighborhood", "community"],
  "storage": "db",
  "automation_actions": {
    "report_item": {
      "title": "Post a lost or found item",
      "description": "Open a lost-and-found post when another app's event fires - something handed in at the front desk, or reported missing through another channel.",
      "params": {
        "reported_by_id": {
          "type": "member",
          "label": "Reported by",
          "required": true
        },
        "title": {
          "type": "text",
          "label": "What it is",
          "required": true
        },
        "kind": {
          "type": "text",
          "label": "Lost or found",
          "default": "found",
          "options": ["lost", "found"]
        },
        "location": {
          "type": "text",
          "label": "Where",
          "default": ""
        }
      },
      "dedupe": {
        "table": "posts",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "posts",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "kind": ":kind",
            "location": ":location",
            "reported_by_id": ":reported_by_id",
            "reported_by_name": "Automation",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "contexts": ["household", "shared_space"],
  "db_plaintext_columns": ["kind"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "row_policies": {
    "posts": {
      "kind": "owner_or_visibility",
      "member_column": "reported_by_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "retain_days": {
        "default": 365,
        "timestamp_column": "created_at",
        "override_key": "post_history",
        "file_id_column": "photo_file_id",
        "exempt_when": { "column": "status", "values": ["open"] }
      }
    }
  },
  "delete_file_columns": {
    "posts": ["photo_file_id"]
  },
  "member_references": {
    "posts": {
      "column": "reported_by_id",
      "on_removed": "keep"
    }
  },
  "publishes": ["lost_and_found.post_created", "lost_and_found.post_resolved"],
  "publish_acls": {"lost_and_found.post_created": {"require_role": "member"}, "lost_and_found.post_resolved": {"require_role": "adult"}},
  "nav": { "label": "Lost & Found" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_lost_and_found__posts WHERE status = 'open' LIMIT 1"
    },
    "display": { "template": "badge", "count": "n", "label": "open posts", "severity": "info" }
  },
  "resource_limits": {
    "max_db_bytes": 10485760,
    "max_file_bytes": 5242880,
    "max_files_bytes": 209715200
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["open_posts"]
  }
}
