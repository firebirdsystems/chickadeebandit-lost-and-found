{
  "id": "lost-and-found",
  "name": "Lost & Found",
  "version": "1.0.0",
  "description": "Post lost or found items — pets, keys, packages, bikes — with a photo and last-known location. Surfaces likely matches between open lost and found posts and closes both out once an item is claimed.",
  "entrypoint": "index.html",
  "runtime": "static",
  "icon": "🔎",
  "category": "community",
  "tags": ["lost", "found", "hoa", "neighborhood", "community"],
  "storage": "db",
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "row_policies": {
    "posts": {
      "kind": "owner_or_visibility",
      "member_column": "reported_by_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"]
    }
  },
  "nav": { "label": "Lost & Found" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_lost_and_found__posts WHERE status = 'open' LIMIT 1"
    },
    "display": { "template": "badge", "count": "n", "label": "open posts", "severity": "info" }
  },
  "resource_limits": {
    "max_db_bytes": 10485760,
    "max_file_bytes": 5242880,
    "max_files_bytes": 209715200
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["open_posts"]
  }
}
